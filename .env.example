# X API OAuth 1.0a user-context credentials. Replace locally; never commit secrets.
APP_KEY=your_app_key
APP_SECRET=your_app_secret
ACCESS_TOKEN=your_access_token
ACCESS_SECRET=your_access_token_secret

# Comma-separated numeric tweet IDs.
TWEET_IDS=1234567890123456789,9876543210987654321

# Optional scheduler and HTTP settings.
PORT=3000
MIN_DELAY_MINUTES=15
MAX_DELAY_MINUTES=45
CYCLE_MINUTES=60
